# ── Site ───────────────────────────────────────────────────────────────
# Canonical URL used for metadata, sitemap, robots and structured data.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://nextageconsult.com

# ── Sanity CMS ─────────────────────────────────────────────────────────
# The site renders built-in fallback content if these are missing.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Shared secret for the Sanity webhook → /api/revalidate (instant content updates).
# Generate one with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# ── Form email delivery (required in production) ───────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=nextageconsult1@gmail.com
CONTACT_FROM_EMAIL=NextAge Website <website@your-verified-domain.com>
